# Local development only. Copy to .env and replace these non-secret defaults as needed.
TRACEKEEP_ENV=development
TRACEKEEP_LOG_LEVEL=INFO
TRACEKEEP_DATABASE_URL=postgresql+psycopg://tracekeep:tracekeep_local@localhost:55432/tracekeep
TRACEKEEP_REDIS_URL=redis://localhost:56379/0
TRACEKEEP_OBJECT_STORE_ENDPOINT=http://localhost:59000
TRACEKEEP_OBJECT_STORE_BUCKET=tracekeep-local
TRACEKEEP_OBJECT_STORE_ACCESS_KEY=tracekeep_local
TRACEKEEP_OBJECT_STORE_SECRET_KEY=replace_for_nonlocal_use

# External providers are intentionally absent from the local foundation.
# Never place real values in this tracked example file.
